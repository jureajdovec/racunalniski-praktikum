Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Subsection"],
 ". naloga:"
}], "Subsection",
 CellChangeTimes->{{3.784103750645109*^9, 3.784103756660742*^9}, {
  3.909139628475746*^9, 
  3.9091396390546637`*^9}},ExpressionUUID->"789078df-9975-4b9d-9de1-\
20a55a51574f"],

Cell[TextData[{
 "1. Dana je matrika  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", 
    RowBox[{"(", GridBox[{
       {"9", "2", 
        RowBox[{"-", "3"}]},
       {"3", "2", "1"},
       {"6", "4", 
        RowBox[{"-", "1"}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "2f615f79-9c97-4dfe-a677-3198c8ebb3d3"],
 ".  Zapi\[SHacek]i jo kot spremenljivko.\n2. Izra\[CHacek]unaj njeno \
determinanto.\n3. Izra\[CHacek]unaj njene lastne vrednosti.\n4. \
Izra\[CHacek]unaj njene lastne vektorje.\n5. Ali je matrika diagonalizabilna?\
\n6. Matriko \[ZHacek]elimo diagonalizirati. Konstruiraj diagonalno matriko \
(po diagonali ima lastne vrednosti), prehodno matriko (za stolpce ima lastne \
vektorje) in inverz prehodne matrike.\n7. Preveri, ali velja pogoj za \
diagonalizabilnost."
}], "Text",
 CellChangeTimes->{{3.943507672012562*^9, 
  3.9435078221864443`*^9}},ExpressionUUID->"7c86d38c-85a9-455d-a0ac-\
30aa8e1854c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"M", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"9", ",", "2", ",", 
      RowBox[{"-", "3"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "4", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Det", "[", "M", "]"}], "\[IndentingNewLine]", 
 RowBox[{"lv", "=", 
  RowBox[{"Eigenvalues", "[", "M", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"lvek", "=", 
  RowBox[{"Eigenvectors", "[", "M", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diagonalna", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", "lv", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"diagonalna", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prehodna", "=", " ", 
   RowBox[{"Transpose", "[", "lvek", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prehodna", " ", "//", " ", "MatrixForm"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inverz", "=", " ", 
   RowBox[{
    RowBox[{"Inverse", "[", "prehodna", "]"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"inverz", " ", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"DiagonalizableMatrixQ", "[", "M", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9772189478272667`*^9, 3.9772190502057705`*^9}, {
  3.977219387080511*^9, 3.977219388107855*^9}, {3.977219612137741*^9, 
  3.9772199963919735`*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"3e07cd50-47dc-014a-afd3-5bef43cbf9e0"],

Cell[BoxData[
 RowBox[{"{", 
