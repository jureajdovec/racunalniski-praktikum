          RowBox[{
           RowBox[{"f", "'"}], "[", "x0", "]"}], ",", 
          RowBox[{"n", "/.", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"x0", ",", 
                RowBox[{
                 RowBox[{"f", "'"}], "[", "x0", "]"}], ",", "n"}], "]"}], "==", 
              RowBox[{"f", "[", "x0", "]"}]}], ",", "n"}], "]"}]}]}], "]"}]}],
        "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
