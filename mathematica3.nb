 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "k_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"k", " ", "x"}], " ", "+", " ", "n"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], ",", 
        RowBox[{"g", "[", 
